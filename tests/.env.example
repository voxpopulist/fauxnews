# Test Environment Variables
# Copy this file to .env and modify as needed

# Base URL for testing
TEST_URL=https://www.voxpopulist.com

# Alternative URLs for different environments
# TEST_URL=http://localhost:4321
# TEST_URL=https://staging.voxpopulist.com

# Browser preferences
BROWSER=chrome
HEADLESS=false

# Test configuration
DEFAULT_TIMEOUT=10000
LONG_TIMEOUT=30000
AUDIO_TIMEOUT=60000

# Screenshot and reporting
SCREENSHOTS_DIR=screenshots
REPORTS_DIR=reports

# Mobile device emulation
MOBILE_DEVICE=iPhone 12
MOBILE_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 15_0 like Mac OS X) AppleWebKit/605.1.15

# Performance testing thresholds
MAX_LOAD_TIME=5000
MAX_FCP_TIME=1800
MAX_LCP_TIME=2500

# Accessibility testing
ACCESSIBILITY_LEVEL=AA
CHECK_COLOR_CONTRAST=true

# Parallel testing
PARALLEL_WORKERS=2

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=1000