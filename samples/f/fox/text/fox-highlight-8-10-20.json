"tokens": [51069, 2386, 766, 11, 286, 8955, 291, 2082, 365, 452, 6597, 1772, 13, 51252], "temperature": 0.0, "avg_logprob": -0.1918547518618472, "compression_ratio": 1.52863436123348, "no_speech_prob": 2.133847352286944e-12}, {"id": 47, "seek": 15264, "start": 170.64, "end": 171.89999999999998, "text": " I am clean-shaven.", "tokens": [51265, 286, 669, 2541, 12, 82, 1641, 553, 13, 51328], "temperature": 0.0, "avg_logprob": -0.1918547518618472, "compression_ratio": 1.52863436123348, "no_speech_prob": 2.133847352286944e-12}, {"id": 48, "seek": 15264, "start": 172.01999999999998, "end": 172.79999999999998, "text": " I'm defined.", "tokens": [51334, 286, 478, 7642, 13, 51373], "temperature": 0.0, "avg_logprob": -0.1918547518618472, "compression_ratio": 1.52863436123348, "no_speech_prob": 2.133847352286944e-12}, {"id": 49, "seek": 15264, "start": 173.01999999999998, "end": 173.95999999999998, "text": " I have great biceps.", "tokens": [51384, 286, 362, 869, 272, 35552, 13, 51431], "temperature": 0.0, "avg_logprob": -0.1918547518618472, "compression_ratio": 1.52863436123348, "no_speech_prob": 2.133847352286944e-12}, {"id": 50, "seek": 15264, "start": 173.95999999999998, "end": 175.45999999999998, "text": " My deltoys are to kill for.", "tokens": [51431, 1222, 1103, 1353, 749, 366, 281, 1961, 337, 13, 51506], "temperature": 0.0, "avg_logprob": -0.1918547518618472, "compression_ratio": 1.52863436123348, "no_speech_prob": 2.133847352286944e-12}, {"id": 51, "seek": 17546, "start": 175.46, "end": 178.02, "text": " Not even to bring up my triceps, but I digress.", "tokens": [50365, 1726, 754, 281, 1565, 493, 452, 504, 35552, 11, 457, 286, 2528, 735, 13, 50493], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 52, "seek": 17546, "start": 178.54000000000002, "end": 180.68, "text": " First off, let's talk about authenticity.", "tokens": [50519, 2386, 766, 11, 718, 311, 751, 466, 34215, 13, 50626], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 53, "seek": 17546, "start": 181.26000000000002, "end": 184.52, "text": " You have RFK, who was fit before he was HHS secretary.", "tokens": [50655, 509, 362, 26204, 42, 11, 567, 390, 3318, 949, 415, 390, 389, 12527, 15691, 13, 50818], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 54, "seek": 17546, "start": 184.92000000000002, "end": 187.44, "text": " Pete Hegseth walked around here with a tank top and tattoos.", "tokens": [50838, 19013, 634, 21559, 3293, 7628, 926, 510, 365, 257, 5466, 1192, 293, 28662, 13, 50964], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 55, "seek": 17546, "start": 187.60000000000002, "end": 187.8, "text": " Oh, yeah.", "tokens": [50972, 876, 11, 1338, 13, 50982], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 56, "seek": 17546, "start": 187.8, "end": 189.3, "text": " We always knew how fit he was.", "tokens": [50982, 492, 1009, 2586, 577, 3318, 415, 390, 13, 51057], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 57, "seek": 17546, "start": 189.4, "end": 189.8, "text": " You know it.", "tokens": [51062, 509, 458, 309, 13, 51082], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 58, "seek": 17546, "start": 189.8, "end": 191.92000000000002, "text": " But you have Javier Bechera and Lloyd Austin.", "tokens": [51082, 583, 291, 362, 508, 25384, 879, 339, 1663, 293, 31401, 15356, 13, 51188], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 59, "seek": 17546, "start": 192.20000000000002, "end": 193.76000000000002, "text": " Let me ask you, who bleeds fitness?", "tokens": [51202, 961, 385, 1029, 291, 11, 567, 5408, 5147, 15303, 30, 51280], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 60, "seek": 17546, "start": 194.20000000000002, "end": 195.48000000000002, "text": " It is, of course, these guys.", "tokens": [51302, 467, 307, 11, 295, 1164, 11, 613, 1074, 13, 51366], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 61, "seek": 17546, "start": 195.78, "end": 198.28, "text": " They were cheering for Donald Trump at UFC events", "tokens": [51381, 814, 645, 11060, 337, 8632, 3899, 412, 48072, 3931, 51506], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 62, "seek": 17546, "start": 198.28, "end": 200.04000000000002, "text": " before he thought about running for president.", "tokens": [51506, 949, 415, 1194, 466, 2614, 337, 3868, 13, 51594], "temperature": 0.0, "avg_logprob": -0.17175854427713744, "compression_ratio": 1.5344262295081967, "no_speech_prob": 1.4797524100149118e-12}, {"id": 63, "seek": 20004, "start": 200.42, "end": 201.45999999999998, "text": " He loves golf.", "tokens": [50384, 634, 6752, 12880, 13, 50436], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 64, "seek": 20004, "start": 201.54, "end": 202.57999999999998, "text": " He shows up at the Ryder Cup.", "tokens": [50440, 634, 3110, 493, 412, 264, 13654, 1068, 13751, 13, 50492], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 65, "seek": 20004, "start": 202.62, "end": 203.67999999999998, "text": " It becomes a frat party.", "tokens": [50494, 467, 3643, 257, 431, 267, 3595, 13, 50547], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 66, "seek": 20004, "start": 204.01999999999998, "end": 207.16, "text": " This is very authentic and sincere.", "tokens": [50564, 639, 307, 588, 12466, 293, 16941, 13, 50721], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 67, "seek": 20004, "start": 207.45999999999998, "end": 208.44, "text": " This is who they are.", "tokens": [50736, 639, 307, 567, 436, 366, 13, 50785], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 68, "seek": 20004, "start": 208.82, "end": 210.57999999999998, "text": " The problem is they spend $10 million.", "tokens": [50804, 440, 1154, 307, 436, 3496, 1848, 3279, 2459, 13, 50892], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 69, "seek": 20004, "start": 211.06, "end": 211.72, "text": " Am I going too long?", "tokens": [50916, 2012, 286, 516, 886, 938, 30, 50949], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 70, "seek": 20004, "start": 211.95999999999998, "end": 214.06, "text": " They spend $10 million on a focus group", "tokens": [50961, 814, 3496, 1848, 3279, 2459, 322, 257, 1879, 1594, 51066], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 71, "seek": 20004, "start": 214.06, "end": 217.35999999999999, "text": " to find out why Democrats are bleeding men.", "tokens": [51066, 281, 915, 484, 983, 12217, 366, 19312, 1706, 13, 51231], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 72, "seek": 20004, "start": 217.57999999999998, "end": 218.35999999999999, "text": " $10 million.", "tokens": [51242, 1848, 3279, 2459, 13, 51281], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 73, "seek": 20004, "start": 218.82, "end": 221.23999999999998, "text": " All they have to find out is what men want", "tokens": [51304, 1057, 436, 362, 281, 915, 484, 307, 437, 1706, 528, 51425], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 74, "seek": 20004, "start": 221.23999999999998, "end": 224.38, "text": " and what they stand for and then work through that lane.", "tokens": [51425, 293, 437, 436, 1463, 337, 293, 550, 589, 807, 300, 12705, 13, 51582], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 75, "seek": 20004, "start": 224.79999999999998, "end": 226.14, "text": " The one thing that Trump has brought,", "tokens": [51603, 440, 472, 551, 300, 3899, 575, 3038, 11, 51670], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 76, "seek": 20004, "start": 226.28, "end": 227.32, "text": " you have to be authentic.", "tokens": [51677, 291, 362, 281, 312, 12466, 13, 51729], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 77, "seek": 20004, "start": 227.45999999999998, "end": 228.32, "text": " You have to be yourself.", "tokens": [51736, 509, 362, 281, 312, 1803, 13, 51779], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 78, "seek": 20004, "start": 228.66, "end": 229.26, "text": " He's tough.", "tokens": [51796, 634, 311, 4930, 13, 51826], "temperature": 0.0, "avg_logprob": -0.17375181833902995, "compression_ratio": 1.77007299270073, "no_speech_prob": 1.5400665768702804e-12}, {"id": 79, "seek": 22926, "start": 229.26, "end": 229.94, "text": " He's crude.", "tokens": [50365, 634, 311, 30796, 13, 50399], "temperature": 0.0, "avg_logprob": -0.2318137288093567, "compression_ratio": 1.5205992509363295, "no_speech_prob": 2.1604957406440306e-12}, {"id": 80, "seek": 22926, "start": 230.35999999999999, "end": 231.45999999999998, "text": " He is insulting.", "tokens": [50420, 634, 307, 44463, 13, 50475], "temperature": 0.0, "avg_logprob": -0.2318137288093567, "compression_ratio": 1.5205992509363295, "no_speech_prob": 2.1604957406440306e-12}, {"id": 81, "seek": 22926, "start": 231.82, "end": 234.22, "text": " But that's who he is, and America embraces it.", "tokens": [50493, 583, 300, 311, 567, 415, 307, 11, 293, 3374, 9392, 2116, 309, 13, 50613], "temperature": 0.0, "avg_logprob": -0.2318137288093567, "compression_ratio": 1.5205992509363295, "no_speech_prob": 2.1604957406440306e-12}, {"id": 82, "seek": 22926, "start": 234.5, "end": 237.56, "text": " And these other people trying to do that is the problem.", "tokens": [50627, 400, 613, 661, 561, 1382, 281, 360, 300, 307, 264, 1154, 13, 50780], "temperature": 0.0, "avg_logprob": -0.2318137288093567, "compression_ratio": 1.5205992509363295, "no_speech_prob": 2.1604957406440306e-12}, {"id": 83, "seek": 22926, "start": 237.72, "end": 238.73999999999998, "text": " Schumer cursed today.", "tokens": [50788, 2065, 15583, 29498, 965, 13, 50839], "temperature": 0.0, "avg_logprob": -0.231813