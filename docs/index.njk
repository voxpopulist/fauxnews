---
layout: layouts/base.njk
title: Faux News
---

<!-- Hero Section -->
<div class="relative overflow-hidden bg-gradient-to-br from-dark-600 via-dark-500 to-dark-400 rounded-2xl p-8 mb-12">
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23334155" fill-opacity="0.1"%3E%3Ccircle cx="30" cy="30" r="1.5"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
  <div class="relative">
    <h1 class="text-3xl md:text-4xl font-bold text-dark-50 mb-4">
      Propaganda chopped up into clips
    </h1>
    <p class="text-lg text-dark-100 leading-relaxed max-w-3xl">
      We clip audio from right-wing media into chunks, turn them into FLACs and transcribe them with AI. Ready to use in your next podcast, video, or meme. Transcripts are searchable by words and phrases.
      Warning: listening to too much of this content may cause extreme facepalming, and you may not be able to unlock your phone for a week afterwards.
    </p>
  </div>
</div>

<!-- Tag Cloud Section -->
{% if samples.tagCloud.length %}
<section class="mb-12">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold text-dark-50 mb-2">Trending Words</h2>
    <p class="text-dark-100">Click any word to filter clips by that term</p>
  </div>
  <div class="bg-dark-400/30 backdrop-blur-sm rounded-2xl p-6 border border-dark-200/20">
    <div class="flex flex-wrap justify-center gap-3">
    {% for tag in samples.tagCloud %}
      <button class="tag-item group relative overflow-hidden" data-word="{{ tag.word }}" data-count="{{ tag.count }}" style="--tag-weight: {{ tag.weight }}">
        <span class="relative z-10 font-medium">{{ tag.word }}</span>
        <span class="relative z-10 ml-2 text-xs bg-primary-400/30 px-2 py-0.5 rounded-full group-hover:bg-primary-400/50 transition-colors duration-200">{{ tag.count }}</span>
        <div class="absolute inset-0 bg-gradient-to-r from-primary-500/20 to-primary-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </button>
    {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Search Section -->
<section class="sticky top-0 z-40 -mx-6 px-6 py-6 bg-dark-500/95 backdrop-blur-xl border-b border-dark-200/20 mb-8 shadow-lg">
  <div class="max-w-2xl mx-auto">
    <label class="block">
      <span class="block text-sm font-semibold text-dark-100 mb-3">Search Transcripts</span>
      <div class="relative">
        <input 
          id="search" 
          class="w-full bg-dark-400/60 border-2 border-dark-200/40 rounded-xl px-6 py-4 pr-14 text-lg text-dark-50 placeholder-dark-100 focus:outline-none focus:border-primary-400 focus:bg-dark-400/80 transition-all duration-300 shadow-inner"
          type="search" 
          placeholder="Type to search any spoken word..."
          autocomplete="off"
        >
      </div>
    </label>
  </div>
</section>

<!-- Results Section -->
<section class="min-h-screen">
  <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8" id="results">
    {# Server-side fallback: render first few samples so the page is usable without JS #}
    {% if samples.samples and samples.samples.length %}
      {% for s in samples.samples | slice(0, 8) %}
        <article class="card-audio group relative bg-gradient-to-br from-dark-400/90 to-dark-500/90 backdrop-blur-sm border border-dark-200/20 rounded-2xl p-6">
          <header class="relative z-10 mb-4">
            <div class="inline-flex items-center gap-2 mb-2">
              <div class="w-10 h-10 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">{{ s.speaker.charAt(0) }}</div>
              <div>
                <h3 class="text-lg font-bold text-dark-50">{{ s.speaker }}</h3>
                <p class="text-xs text-dark-100 font-mono">{{ s.filename }}</p>
              </div>
            </div>
          </header>
          <div class="mb-4">
            <audio class="w-full rounded-lg" controls preload="none" src="{{ s.mp3Src }}"></audio>
          </div>
          <div class="mt-4 text-dark-100 text-sm">{{ s.preview }}</div>
        </article>
      {% endfor %}
    {% else %}
      <div class="col-span-full flex flex-col items-center justify-center py-24">
        <div class="animate-spin w-8 h-8 border-2 border-dark-300 border-t-primary-500 rounded-full mb-4"></div>
        <p class="text-dark-100 text-lg">Loading clips...</p>
      </div>
    {% endif %}
  </div>
</section>

<!-- Results Count -->
<div class="flex justify-center mt-8 pb-12">
  <p class="text-dark-100 font-medium" id="resultsCount"></p>
</div>

<!-- Scripts included in base layout -->
