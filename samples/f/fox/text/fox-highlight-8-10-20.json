 {"id": 90, "seek": 22926, "start": 253.76, "end": 253.92, "text": " Yeah.", "tokens": [51590, 865, 13, 51598], "temperature": 0.0, "avg_logprob": -0.2318137288093567, "compression_ratio": 1.5205992509363295, "no_speech_prob": 2.1604957406440306e-12}, {"id": 91, "seek": 22926, "start": 254.0, "end": 255.72, "text": " Do you think the Democrats can fake", "tokens": [51602, 1144, 291, 519, 264, 12217, 393, 7592, 51688], "temperature": 0.0, "avg_logprob": -0.2318137288093567, "compression_ratio": 1.5205992509363295, "no_speech_prob": 2.1604957406440306e-12}, {"id": 92, "seek": 25572, "start": 255.72, "end": 258.42, "text": " being into something that guys like", "tokens": [50365, 885, 666, 746, 300, 1074, 411, 50500], "temperature": 0.0, "avg_logprob": -0.23651409149169922, "compression_ratio": 1.3255813953488371, "no_speech_prob": 5.904898531944314e-12}, {"id": 93, "seek": 25572, "start": 258.42, "end": 259.68, "text": " until they make it?", "tokens": [50500, 1826, 436, 652, 309, 30, 50563], "temperature": 0.0, "avg_logprob": -0.23651409149169922, "compression_ratio": 1.3255813953488371, "no_speech_prob": 5.904898531944314e-12}, {"id": 94, "seek": 25572, "start": 260.28, "end": 262.68, "text": " I'm not crazy about the idea of,", "tokens": [50593, 286, 478, 406, 3219, 466, 264, 1558, 295, 11, 50713], "temperature": 0.0, "avg_logprob": -0.23651409149169922, "compression_ratio": 1.3255813953488371, "no_speech_prob": 5.904898531944314e-12}, {"id": 95, "seek": 25572, "start": 262.94, "end": 266.38, "text": " I feel like they have the equation reversed.", "tokens": [50726, 286, 841, 411, 436, 362, 264, 5367, 30563, 13, 50898], "temperature": 0.0, "avg_logprob": -0.23651409149169922, "compression_ratio": 1.3255813953488371, "no_speech_prob": 5.904898531944314e-12}, {"id": 96, "seek": 25572, "start": 266.72, "end": 269.0, "text": " It's like, we're interested in Trump.", "tokens": [50915, 467, 311, 411, 11, 321, 434, 3102, 294, 3899, 13, 51029], "temperature": 0.0, "avg_log