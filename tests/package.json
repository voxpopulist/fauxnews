{
  "name": "fauxnews-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Faux News website",
  "type": "module",
  "scripts": {
    "test": "mocha 'smoke/*.test.js' --timeout 60000",
    "test:critical": "mocha 'critical/*.test.js' --timeout 90000",
    "test:headless": "HEADLESS=true npm run test:critical",
    "test:chrome": "BROWSER=chrome npm run test:critical",
    "test:firefox": "BROWSER=firefox npm run test:critical",
    "test:safari": "BROWSER=safari npm run test:critical",
    "test:edge": "BROWSER=edge npm run test:critical",
    "test:mobile": "mocha 'mobile/*.test.js' --timeout 60000",
    "test:desktop": "mocha 'desktop/*.test.js' --timeout 60000",
  "test:mobile-emulation": "BROWSER=chrome MOBILE=true npm run test:critical",
  "test:cross-browser": "CROSS=true npm run test:critical",
    "test:smoke": "mocha 'smoke/*.test.js' --timeout 30000",
    "test:functional": "mocha 'functional/*.test.js' --timeout 90000",
    "test:performance": "mocha 'performance/*.test.js' --timeout 120000",
    "test:accessibility": "mocha 'accessibility/*.test.js' --timeout 60000",
    "test:responsive": "mocha 'responsive/*.test.js' --timeout 60000",
    "test:parallel": "mocha '**/*.test.js' --parallel --timeout 60000",
    "test:watch": "mocha '**/*.test.js' --watch --timeout 60000",
    "test:report": "npm run test:critical -- --reporter mochawesome",
    "test:all": "npm run test:critical && npm run test:functional && npm run test:mobile",
    "setup": "npm install",
    "clean": "rm -rf reports screenshots"
  },
  "devDependencies": {
    "selenium-webdriver": "^4.36.0",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "mochawesome": "^7.1.3",
    "chromedriver": "^141.0.2",
    "geckodriver": "^4.2.1",
    "edgedriver": "^5.4.0",
    "axe-core": "^4.8.2",
    "lighthouse": "^13.0.0",
    "puppeteer": "^24.26.1",
    "playwright": "^1.40.1",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "jimp": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}